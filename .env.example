# Neon Postgres
DATABASE_URL=

# AWS Cognito
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_REGION=
COGNITO_ISSUER=

NEXT_PUBLIC_COGNITO_REGION=
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=
NEXT_PUBLIC_COGNITO_DOMAIN=

# Token encryption key (64 hex chars for AES-256-GCM)
TOKEN_ENCRYPTION_KEY=

# Iron-session cookie secret (32+ characters)
SESSION_COOKIE_SECRET=

# OpenAI (server-side only — do NOT prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# Legacy client-side key (used in demo mode only)
NEXT_PUBLIC_OPENAI_API_KEY=
NEXT_PUBLIC_OPENAI_MODEL=gpt-5.2

# Auth toggle: set to "true" to enable Cognito auth + DB persistence
NEXT_PUBLIC_AUTH_ENABLED=

ADMIN_EMAILS=
