# Neon Postgres
DATABASE_URL=

# AWS Cognito
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_REGION=
COGNITO_ISSUER=

NEXT_PUBLIC_COGNITO_REGION=
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=
NEXT_PUBLIC_COGNITO_DOMAIN=

# Token encryption key (64 hex chars for AES-256-GCM)
TOKEN_ENCRYPTION_KEY=

# Iron-session cookie secret (32+ characters)
SESSION_COOKIE_SECRET=

# OpenAI (server-side only — do NOT prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=

# OpenAI model override
NEXT_PUBLIC_OPENAI_MODEL=

# Default MCP server seeded on startup (re-added after restart if deleted from UI)
NEXT_PUBLIC_DEFAULT_MCP_SERVER_URL=
NEXT_PUBLIC_DEFAULT_MCP_SERVER_NAME=

# Auth toggle: set to "true" to enable Cognito auth + DB persistence
NEXT_PUBLIC_AUTH_ENABLED=false

ADMIN_EMAILS=

# Guardrails
GUARDRAILS_ENABLED=true
GUARDRAILS_INPUT_MODERATION=true
GUARDRAILS_OUTPUT_MODERATION=true
GUARDRAILS_FAIL_CLOSED=true

# Claims-only search config
CLAIMS_ALLOWED_URL_PREFIX=https://www.income.com.sg/claims
CLAIMS_ALLOWED_DOMAIN=income.com.sg
SEARCH_MAX_TOOL_CALLS=2
CLAIMS_CACHE_TTL_SECONDS=900
